# =============================================================================
# .env.example — Environment variable template
#
# Copy this file to .env and fill in your actual values.
# The .env file is listed in .gitignore and will NEVER be committed.
#
# These variables are used by:
# - docker-compose.yml (Docker Compose reads .env automatically)
# - The Spring Boot app when run locally (export them to your shell, or use
#   IntelliJ's "EnvFile" plugin to load .env automatically on run)
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values, then:
#   source .env && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# =============================================================================

# =============================================================================
# PostgreSQL — must match docker-compose.yml and application-dev.properties
# =============================================================================
POSTGRES_DB=aitken_junior_db
POSTGRES_USER=aitken_user
POSTGRES_PASSWORD=aitken_pass

# =============================================================================
# Discord Bot Token
# Get this from: https://discord.com/developers/applications
# → Your Application → Bot → Reset Token
# KEEP THIS SECRET — treat it like a password.
# =============================================================================
DISCORD_BOT_TOKEN=your-discord-bot-token-here

