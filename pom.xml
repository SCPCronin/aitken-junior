<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent POM — provides dependency management and plugin defaults.
        Upgrading Spring Boot version here automatically upgrades all managed dependencies.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>AitkenJunior</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AitkenJunior</name>
    <description>
        Personal projects platform backbone — an extensible Spring Boot application providing
        REST API, PostgreSQL persistence, Discord bot integration, and a structured module system
        to rapidly build new features.
    </description>

    <properties>
        <!-- Java version — Spring Boot 3.x requires Java 17+ -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Dependency versions not managed by the Spring Boot BOM -->
        <jda.version>5.2.2</jda.version>
    </properties>

    <dependencies>

        <!-- ============================================================
             CORE WEB
             spring-boot-starter-web brings in:
             - Embedded Tomcat server
             - Spring MVC (controllers, request mapping)
             - Jackson (JSON serialisation)
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             DATA ACCESS
             spring-boot-starter-data-jpa brings in:
             - Hibernate ORM
             - Spring Data JPA repositories
             - Transaction management
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver — connects the app to the Postgres container -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             DATABASE MIGRATIONS
             Flyway manages schema versioning — every change to the DB schema
             is captured as a numbered SQL script in db/migration/.
             This guarantees the schema is reproducible across environments.
             ============================================================ -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway Postgres extension required for Flyway 10+ with Postgres -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============================================================
             MONITORING & OPERATIONS
             Actuator exposes /actuator/health, /actuator/info, and metrics
             endpoints. Useful for health checks in Docker Compose and
             production deployments.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================================================
             VALIDATION
             Bean Validation (JSR-380) annotations like @NotBlank, @Size, etc.
             Used on request DTOs in controllers.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             DEVELOPER EXPERIENCE
             Lombok reduces boilerplate: @Getter, @Setter, @Builder, etc.
             are processed at compile time — no runtime cost.
             ============================================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot DevTools — live reload during local development.
             Automatically excluded from production builds. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             DISCORD BOT (JDA — Java Discord API)
             JDA is a well-maintained library for building Discord bots.
             It is added here so the Discord module can be developed in PR 2.
             ============================================================ -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>${jda.version}</version>
            <!-- Exclude the bundled audio libraries — not needed for a text bot -->
            <exclusions>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============================================================
             TESTING
             spring-boot-starter-test bundles:
             - JUnit 5
             - Mockito
             - AssertJ
             - MockMvc (for controller integration tests)
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 in-memory database for tests — avoids needing a running Postgres instance in CI -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Maven Compiler Plugin — explicitly configure Lombok as an annotation processor.
                This is required so that Lombok generates getters, setters, constructors, etc.
                during compilation. Without this, @Getter/@Setter annotations are not processed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- Lombok must be listed as an annotation processor path -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Spring Boot Maven Plugin — packages the app as an executable fat JAR.
                The 'repackage' goal runs automatically on 'mvn package'.
                The Lombok exclude ensures generated code is not included in the final jar.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>


